# ------- 基础 -------
PORT=3001
SQLITE_PATH=./data/nankaiquetao.db
AUTH_JWT_SECRET=change-me-to-a-long-random-string
CORS_ORIGINS=http://localhost:8080,http://localhost:5173

# ------- 文本对话 AI (OpenAI 兼容网关, 已有) -------
AI_API_KEY=
AI_BASE_URL=
AI_CHAT_MODEL=
# 复用同一网关做「图片理解」: 填一个多模态模型名; 留空则回退用 AI_CHAT_MODEL
AI_VISION_MODEL=
# 复用同一网关做「语音合成」: 需网关支持 /v1/audio/speech, 填 TTS 模型名 (如 gpt-4o-mini-tts / tts-1)
AI_TTS_MODEL=
AI_TTS_VOICE=alloy

# ------- 阿里云百炼 DashScope (可选; 配置后 TTS/图片会优先走百炼) -------
# 若上面的现有网关不支持语音合成, 再来这里开通: https://bailian.console.aliyun.com/
DASHSCOPE_API_KEY=

# 语音合成 (CosyVoice / Qwen-TTS). 一般无需改动 URL
DASHSCOPE_TTS_URL=https://dashscope.aliyuncs.com/api/v1/services/aigc/multimodal-generation/generation
DASHSCOPE_TTS_MODEL=cosyvoice-v3-flash
# 缺省音色 (中西共用). 如需分别指定可设置下面两个; 音色列表见百炼文档
DASHSCOPE_TTS_VOICE=longxiaochun
# DASHSCOPE_TTS_VOICE_ZH=longxiaochun
# DASHSCOPE_TTS_VOICE_ES=longxiaochun

# 图片理解 (Qwen-VL, OpenAI 兼容端点)
DASHSCOPE_VISION_URL=https://dashscope.aliyuncs.com/compatible-mode/v1/chat/completions
DASHSCOPE_VISION_MODEL=qwen-vl-plus
